depth = -bbox_bottom

spd = 0

image_speed = 1.2
image_xscale = 1.2
image_yscale = 1.2

sprite[0] = spr_librarian_right_new; //this is an array
sprite[1] = spr_librarian_up_new; //the numbers in the brackets are variables for the macros
sprite[2] = spr_librarian_left_new; //it would be the same as typing in LEFT or RIGHT
sprite[3] = spr_librarian_down_new;  //but LEFT and RIGHTS values now mean the same thing as 0 and 3
